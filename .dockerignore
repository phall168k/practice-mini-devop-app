# Dependencies (install inside the image)
**/node_modules

# NestJS and NuxtJS build output
**/dist
**/.nuxt
**/.output
**/.nitro
**/.cache
**/.turbo
**/*.tsbuildinfo

# Test coverage and logs
**/coverage
**/.nyc_output
**/*.log

# Local environment files (keep examples)
**/.env
**/.env.*
!**/.env.example
!**/.env.*.example

# Version control, editor settings, and local credentials
**/.git
**/.gitignore
**/.idea
**/.vscode
**/.DS_Store
**/Thumbs.db
.agents
.codex
.aws
